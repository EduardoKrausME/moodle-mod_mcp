{{!
    @template mod_mcp/material_templates

    Example context (json):
    {
        "courseid": 4,
        "templates": [{"scope": "course", "label": "Course templates", "empty": true, "canedit": true}],
        "prompts": [{"scope": "course", "label": "Course templates", "prompt": "Create a reusable style"}]
    }
}}
<section id="mod-mcp-material-templates-{{courseid}}" class="my-3">
    <h2>{{#str}}materialtemplatesmanage, mcp{{/str}}</h2>
    <p>{{#str}}materialtemplateshelp, mcp{{/str}}</p>
    <div class="row">
        {{#templates}}
            <div class="col-12 col-lg-6 mb-3">
                <section class="card h-100">
                    <div class="card-body">
                        <h3 class="h5">{{label}}</h3>
                        {{#configured}}
                            <p class="fw-bold mb-2">{{name}}</p>
                            <div class="border rounded p-3 text-break mb-3" style="white-space: pre-wrap;">{{style}}</div>
                        {{/configured}}
                        {{#invalid}}
                            <p class="text-danger">{{#str}}materialtemplatesinvalid, mcp{{/str}}</p>
                        {{/invalid}}
                        {{#empty}}
                            <p class="text-muted">{{#str}}materialtemplatesempty, mcp{{/str}}</p>
                        {{/empty}}
                        {{#canedit}}
                            <a class="btn btn-outline-secondary" href="{{editurl}}">
                                {{#str}}materialtemplatesmanual, mcp{{/str}}
                            </a>
                        {{/canedit}}
                        {{^canedit}}
                            <p class="small text-muted mb-0">{{#str}}materialtemplatesreadonly, mcp{{/str}}</p>
                        {{/canedit}}
                    </div>
                </section>
            </div>
        {{/templates}}
    </div>
    <details class="border rounded p-3">
        <summary class="fw-bold">{{#str}}materialtemplatescreate, mcp{{/str}}</summary>
        <p class="mt-3">{{#str}}materialtemplatescreatehelp, mcp{{/str}}</p>
        {{#prompts}}
            <section class="mb-3" data-template-prompt>
                <h3 class="h5">{{label}}</h3>
                {{#replace}}
                    <p class="text-muted">{{#str}}materialtemplatesreplace, mcp{{/str}}</p>
                {{/replace}}
                <label class="form-label" for="material-template-prompt-{{scope}}-{{courseid}}">
                    {{#str}}copyinstructions, mcp{{/str}}
                </label>
                <textarea class="form-control mb-2" id="material-template-prompt-{{scope}}-{{courseid}}"
                          rows="8" readonly data-template-field>{{prompt}}</textarea>
                <button type="button" class="btn btn-primary" data-template-copy
                        data-success="{{#str}}copypromptsucceeded, mcp{{/str}}"
                        data-error="{{#str}}copypromptfailed, mcp{{/str}}">
                    {{#str}}copyprompt, mcp{{/str}}
                </button>
                <span class="ms-2" role="status" aria-live="polite" data-template-status></span>
            </section>
        {{/prompts}}
    </details>
</section>
{{#js}}
require([], function() {
    var root = document.getElementById('mod-mcp-material-templates-{{courseid}}');
    if (!root) {
        return;
    }
    root.querySelectorAll('[data-template-prompt]').forEach(function(panel) {
        var button = panel.querySelector('[data-template-copy]');
        var field = panel.querySelector('[data-template-field]');
        var status = panel.querySelector('[data-template-status]');
        function fallback() {
            field.focus();
            field.select();
            try {
                return document.execCommand('copy');
            } catch (error) {
                return false;
            }
        }
        function copy() {
            if (button.disabled) {
                return;
            }
            button.disabled = true;
            status.textContent = '';
            field.select();
            var result = navigator.clipboard && navigator.clipboard.writeText ?
                navigator.clipboard.writeText(field.value).then(function() {
                    return true;
                }).catch(fallback) : Promise.resolve(fallback());
            result.then(function(copied) {
                status.textContent = button.getAttribute(copied ? 'data-success' : 'data-error');
            }).catch(function() {
                status.textContent = button.getAttribute('data-error');
            }).then(function() {
                button.disabled = false;
            });
        }
        button.addEventListener('click', copy);
        field.addEventListener('click', copy);
    });
});
{{/js}}
