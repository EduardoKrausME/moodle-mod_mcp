{{!
    @template mod_mcp/prompt_selector

    Example context (json):
    {
        "cmid": 27,
        "promptoptions": [{"type": "interactive", "label": "Quiz", "prompt": "Build an interactive activity..."}]
    }
}}
<div id="mcp-prompt-selector-{{cmid}}" class="mod-mcp-prompt-selector mb-3">
    <p class="mb-2 fw-bold">{{#str}}promptselecttitle, mcp{{/str}}</p>
    <div class="mod-mcp-prompt-tabs">
        <div class="nav nav-tabs flex-nowrap" role="tablist"
             aria-label="{{#str}}promptselecttitle, mcp{{/str}}">
        {{#promptoptions}}
            <button type="button" id="mcp-prompt-tab-{{type}}-{{cmid}}" class="nav-link text-nowrap"
                    role="tab" data-prompt-choice="{{type}}" aria-selected="false" tabindex="-1"
                    aria-controls="mcp-prompt-{{type}}-{{cmid}}">
                {{label}}
            </button>
        {{/promptoptions}}
        </div>
    </div>
    <div class="mod-mcp-prompt-content">
    {{#promptoptions}}
        <div id="mcp-prompt-{{type}}-{{cmid}}" role="tabpanel" tabindex="0"
             aria-labelledby="mcp-prompt-tab-{{type}}-{{cmid}}" data-prompt-panel="{{type}}" hidden>
            <div class="mod-mcp-prompt-intro">
                <div class="mod-mcp-prompt-intro-text">
                    <label class="form-label" for="mcp-prompt-{{type}}-text-{{cmid}}">
                        {{#str}}copyinstructions, mcp{{/str}}
                    </label>
                    <p id="mcp-prompt-{{type}}-desc-{{cmid}}" class="mcp-prompt-desc mb-0">{{description}}</p>
                    <p id="mcp-prompt-{{type}}-freedom-{{cmid}}" class="mcp-prompt-freedom mt-2 mb-0">
                        {{#str}}promptfreedom, mcp{{/str}}
                    </p>
                </div>
                <img class="mod-mcp-prompt-image" src="{{{imageurl}}}" alt="{{imagealt}}"
                     width="580" loading="lazy">
            </div>
            <textarea id="mcp-prompt-{{type}}-text-{{cmid}}" class="form-control mb-2"
                      aria-describedby="mcp-prompt-{{type}}-desc-{{cmid}} mcp-prompt-{{type}}-freedom-{{cmid}}"
                      rows="8" readonly>{{prompt}}</textarea>
            <div class="d-flex flex-wrap align-items-center mb-3">
                <button type="button" class="btn btn-primary me-2 mb-2" data-copy-prompt
                        data-target="mcp-prompt-{{type}}-text-{{cmid}}">
                    {{#str}}copyprompt, mcp{{/str}}
                </button>
                <span class="small mb-2" data-copy-status aria-live="polite" role="status"></span>
            </div>
        </div>
    {{/promptoptions}}
    </div>
</div>
{{#js}}
require([], function() {
    var root = document.getElementById('mcp-prompt-selector-{{cmid}}');
    if (!root) {
        return;
    }

    var choices = root.querySelectorAll('[data-prompt-choice]');
    var panels = root.querySelectorAll('[data-prompt-panel]');
    function activateTab(button, moveFocus) {
        var selected = button.getAttribute('data-prompt-choice');
        Array.prototype.forEach.call(choices, function(choice) {
            var active = choice === button;
            choice.setAttribute('aria-selected', active ? 'true' : 'false');
            choice.setAttribute('tabindex', active ? '0' : '-1');
            choice.classList.toggle('active', active);
        });
        Array.prototype.forEach.call(panels, function(panel) {
            panel.hidden = panel.getAttribute('data-prompt-panel') !== selected;
            var status = panel.querySelector('[data-copy-status]');
            if (status) {
                status.textContent = '';
            }
        });
        if (moveFocus) {
            button.focus();
        }
    }

    Array.prototype.forEach.call(choices, function(button, index) {
        button.addEventListener('click', function() {
            activateTab(button, false);
        });
        button.addEventListener('keydown', function(event) {
            var next;
            switch (event.key) {
                case 'ArrowRight':
                    next = (index + 1) % choices.length;
                    break;
                case 'ArrowLeft':
                    next = (index - 1 + choices.length) % choices.length;
                    break;
                case 'Home':
                    next = 0;
                    break;
                case 'End':
                    next = choices.length - 1;
                    break;
                default:
                    return;
            }
            event.preventDefault();
            activateTab(choices[next], true);
        });
    });
    if (choices.length) {
        activateTab(choices[0], false);
    }

    // Copy only the selected mode's complete prompt, never the label or other panels.
    function copyFallback(field) {
        field.focus();
        field.select();
        try {
            return document.execCommand('copy');
        } catch (error) {
            return false;
        }
    }

    var copyButtons = root.querySelectorAll('[data-copy-prompt]');
    Array.prototype.forEach.call(copyButtons, function(button) {
        button.addEventListener('click', function() {
            var panel = button.closest('[data-prompt-panel]');
            if (!panel || panel.hidden || button.disabled) {
                return;
            }
            var field = panel.querySelector('textarea');
            var status = panel.querySelector('[data-copy-status]');
            if (!field || !status) {
                return;
            }
            button.disabled = true;
            status.textContent = '';
            var value = field.value;
            var result;
            try {
                if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
                    result = navigator.clipboard.writeText(value).catch(function() {
                        return copyFallback(field);
                    });
                } else {
                    result = Promise.resolve(copyFallback(field));
                }
            } catch (error) {
                result = Promise.resolve(copyFallback(field));
            }
            Promise.resolve(result).then(function(copied) {
                // Clipboard.writeText resolves with undefined on success.
                status.textContent = copied === false ?
                    '{{#str}}copypromptfailed, mcp{{/str}}' :
                    '{{#str}}copypromptsucceeded, mcp{{/str}}';
            }).catch(function() {
                field.focus();
                field.select();
                status.textContent = '{{#str}}copypromptfailed, mcp{{/str}}';
            }).then(function() {
                button.disabled = false;
            });
        });
    });
});
{{/js}}
