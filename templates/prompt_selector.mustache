{{!
    @template mod_mcp/prompt_selector

    Example context (json):
    {
        "cmid": 27,
        "promptoptions": [{"type": "interactive", "label": "Quiz", "prompt": "Build an interactive activity..."}]
    }
}}
<div id="mcp-prompt-selector-{{cmid}}" class="mod-mcp-prompt-selector mb-3"
     data-copy-success="{{#str}}copypromptsucceeded, mcp{{/str}}"
     data-copy-error="{{#str}}copypromptfailed, mcp{{/str}}"
     data-copy-toast="{{#str}}copypromptfloat, mcp{{/str}}">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
        <p class="mb-0 fw-bold">{{#str}}promptselecttitle, mcp{{/str}}</p>
        {{#themeconfigurl}}
            <a class="btn btn-outline-secondary" href="{{{themeconfigurl}}}" target="_blank" rel="noopener noreferrer">
                {{#str}}materialtemplatesmanage, mcp{{/str}}
                <span class="visually-hidden sr-only">({{#str}}materialtemplatesnewwindow, mcp{{/str}})</span>
            </a>
        {{/themeconfigurl}}
    </div>
    <div class="mod-mcp-prompt-tabs">
        <div class="nav nav-tabs flex-nowrap" role="tablist"
             aria-label="{{#str}}promptselecttitle, mcp{{/str}}">
        {{#promptoptions}}
            <button type="button" id="mcp-prompt-tab-{{type}}-{{cmid}}" class="nav-link text-nowrap"
                    role="tab" data-prompt-choice="{{type}}" aria-selected="false" tabindex="-1"
                    aria-controls="mcp-prompt-{{type}}-{{cmid}}">
                {{label}}
            </button>
        {{/promptoptions}}
        </div>
    </div>
    <div class="mod-mcp-prompt-content">
    {{#promptoptions}}
        <div id="mcp-prompt-{{type}}-{{cmid}}" role="tabpanel" tabindex="0"
             aria-labelledby="mcp-prompt-tab-{{type}}-{{cmid}}" data-prompt-panel="{{type}}" hidden>
            <div class="mod-mcp-prompt-intro">
                <div class="mod-mcp-prompt-intro-text">
                    <label class="form-label" for="mcp-prompt-{{type}}-text-{{cmid}}">
                        {{#str}}copyinstructions, mcp{{/str}}
                    </label>
                    <p id="mcp-prompt-{{type}}-desc-{{cmid}}" class="mcp-prompt-desc mb-0">{{{description}}}</p>
                    <p id="mcp-prompt-{{type}}-freedom-{{cmid}}" class="mcp-prompt-freedom mt-2 mb-0">
                        {{#str}}promptfreedom, mcp{{/str}}
                    </p>
                </div>
                <img class="mod-mcp-prompt-image" src="{{{imageurl}}}" alt="{{imagealt}}"
                     width="580" loading="lazy">
            </div>
            <p id="mcp-prompt-{{type}}-hint-{{cmid}}" class="small text-muted mb-1">
                {{#str}}promptclicktocopy, mcp{{/str}}
            </p>
            <textarea id="mcp-prompt-{{type}}-text-{{cmid}}"
                      class="form-control mb-2 mcp-prompt-click-copy" data-copy-prompt-field
                      aria-describedby="mcp-prompt-{{type}}-desc-{{cmid}} mcp-prompt-{{type}}-freedom-{{cmid}} mcp-prompt-{{type}}-hint-{{cmid}}"
                      rows="8" readonly>{{prompt}}</textarea>
            <div class="d-flex flex-wrap align-items-center mb-3">
                <button type="button" class="btn btn-primary me-2 mb-2" data-copy-prompt
                        data-target="mcp-prompt-{{type}}-text-{{cmid}}">
                    {{#str}}copyprompt, mcp{{/str}}
                </button>
                <span class="small mb-2" data-copy-status aria-live="polite" role="status"></span>
            </div>
        </div>
    {{/promptoptions}}
    </div>
</div>
{{#js}}
require([], function() {
    var root = document.getElementById('mcp-prompt-selector-{{cmid}}');
    if (!root) {
        return;
    }

    var choices = root.querySelectorAll('[data-prompt-choice]');
    var panels = root.querySelectorAll('[data-prompt-panel]');
    var activeToast = null;

    function removeToast() {
        if (activeToast) {
            activeToast.remove();
            activeToast = null;
        }
    }

    function activateTab(button, moveFocus) {
        var selected = button.getAttribute('data-prompt-choice');
        removeToast();
        Array.prototype.forEach.call(choices, function(choice) {
            var active = choice === button;
            choice.setAttribute('aria-selected', active ? 'true' : 'false');
            choice.setAttribute('tabindex', active ? '0' : '-1');
            choice.classList.toggle('active', active);
        });
        Array.prototype.forEach.call(panels, function(panel) {
            panel.hidden = panel.getAttribute('data-prompt-panel') !== selected;
            var status = panel.querySelector('[data-copy-status]');
            if (status) {
                status.textContent = '';
            }
        });
        if (moveFocus) {
            button.focus();
        }
    }

    Array.prototype.forEach.call(choices, function(button, index) {
        button.addEventListener('click', function() {
            activateTab(button, false);
        });
        button.addEventListener('keydown', function(event) {
            var next;
            switch (event.key) {
                case 'ArrowRight':
                    next = (index + 1) % choices.length;
                    break;
                case 'ArrowLeft':
                    next = (index - 1 + choices.length) % choices.length;
                    break;
                case 'Home':
                    next = 0;
                    break;
                case 'End':
                    next = choices.length - 1;
                    break;
                default:
                    return;
            }
            event.preventDefault();
            activateTab(choices[next], true);
        });
    });
    if (choices.length) {
        activateTab(choices[0], false);
    }

    // Show a small, non-interactive confirmation beside the pointer or tap location.
    function showCopyToast(source, event) {
        removeToast();
        var toast = document.createElement('span');
        toast.className = 'mod-mcp-copy-toast';
        toast.setAttribute('aria-hidden', 'true');
        toast.textContent = root.getAttribute('data-copy-toast');
        document.body.appendChild(toast);
        activeToast = toast;

        var rect = source.getBoundingClientRect();
        var pointer = event && event.detail !== 0 && Number.isFinite(event.clientX) &&
            Number.isFinite(event.clientY) && (event.clientX !== 0 || event.clientY !== 0);
        var x = pointer ? event.clientX : rect.left + rect.width / 2;
        var y = pointer ? event.clientY : rect.top + rect.height / 2;
        var halfWidth = toast.offsetWidth / 2;
        var viewportWidth = document.documentElement.clientWidth || window.innerWidth;
        var viewportHeight = document.documentElement.clientHeight || window.innerHeight;
        toast.style.left = Math.max(halfWidth + 12, Math.min(viewportWidth - halfWidth - 12, x)) + 'px';
        toast.style.top = Math.max(42, Math.min(viewportHeight - 12, y - 8)) + 'px';

        toast.addEventListener('animationend', function() {
            if (activeToast === toast) {
                removeToast();
            } else {
                toast.remove();
            }
        }, {once: true});
        // Remove the node even if the animation is disabled by the host.
        window.setTimeout(function() {
            if (activeToast === toast) {
                removeToast();
            }
        }, 1600);
    }

    function copyFallback(field) {
        field.focus();
        field.select();
        try {
            return document.execCommand('copy');
        } catch (error) {
            return false;
        }
    }

    function copyPrompt(panel, source, event) {
        if (!panel || panel.hidden || panel.getAttribute('data-copying') === 'true') {
            return;
        }
        var field = panel.querySelector('[data-copy-prompt-field]');
        var status = panel.querySelector('[data-copy-status]');
        var button = panel.querySelector('[data-copy-prompt]');
        if (!field || !status) {
            return;
        }

        // Keep the full prompt selected even if clipboard access is denied.
        field.focus();
        field.select();
        status.textContent = '';
        panel.setAttribute('data-copying', 'true');
        if (button) {
            button.disabled = true;
        }

        var result;
        try {
            if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
                result = navigator.clipboard.writeText(field.value).catch(function() {
                    return copyFallback(field);
                });
            } else {
                result = copyFallback(field);
            }
        } catch (error) {
            result = copyFallback(field);
        }

        Promise.resolve(result).then(function(copied) {
            if (!panel.hidden) {
                var success = copied !== false;
                status.textContent = root.getAttribute(success ? 'data-copy-success' : 'data-copy-error');
                if (success) {
                    showCopyToast(source, event);
                }
            }
        }).catch(function() {
            if (!panel.hidden) {
                status.textContent = root.getAttribute('data-copy-error');
            }
        }).then(function() {
            panel.removeAttribute('data-copying');
            if (button) {
                button.disabled = false;
            }
        });
    }

    // A click or tap on the readonly text selects and copies it directly.
    Array.prototype.forEach.call(root.querySelectorAll('[data-copy-prompt-field]'), function(field) {
        field.addEventListener('click', function(event) {
            copyPrompt(field.closest('[data-prompt-panel]'), field, event);
        });
    });

    // Retain the explicit button for keyboard users and accessibility.
    Array.prototype.forEach.call(root.querySelectorAll('[data-copy-prompt]'), function(button) {
        button.addEventListener('click', function(event) {
            copyPrompt(button.closest('[data-prompt-panel]'), button, event);
        });
    });
});
{{/js}}
