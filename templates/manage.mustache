<section class="card p-4 my-3">
  <h2>{{#str}}manageactivity, mcp{{/str}}</h2>
  <p>{{#str}}copyinstructions, mcp{{/str}}</p>
  <textarea class="form-control mb-3" rows="7" readonly>{{prompt}}</textarea>
  <a class="btn btn-outline-secondary mb-3" href="{{previewurl}}">{{#str}}preview, mcp{{/str}}</a>
  {{#canpublish}}
    <form action="{{actionurl}}" method="post">
      <input type="hidden" name="sesskey" value="{{sesskey}}">
      <input type="hidden" name="id" value="{{cmid}}">
      <input type="hidden" name="revision" value="{{revision}}">
      <input type="hidden" name="action" value="publish">
      <button class="btn btn-primary" type="submit">{{#str}}publish, mcp{{/str}}</button>
    </form>
  {{/canpublish}}
</section>
