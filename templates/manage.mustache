{{!
    @template mod_mcp/manage

    Example context (json):
    {
    }
}}
<section class="card p-4 my-3">
    <h2>{{#str}}editcontent, mcp{{/str}}</h2>
    <form action="{{actionurl}}" method="post">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="id" value="{{cmid}}">
        <input type="hidden" name="revision" value="{{revision}}">
        <input type="hidden" name="action" value="save">
        <div class="mb-3">
            <label class="form-label" for="mod-mcp-html-content">{{#str}}content, mcp{{/str}}</label>
            <textarea class="form-control font-monospace" name="content" id="mod-mcp-html-content"
                      rows="24" spellcheck="false" aria-describedby="mod-mcp-content-help">{{draftcontent}}</textarea>
            <div class="form-text" id="mod-mcp-content-help">{{#str}}content_help, mcp{{/str}}</div>
        </div>
        <button class="btn btn-primary" type="submit">{{#str}}savedraft, mcp{{/str}}</button>
    </form>
</section>
<section class="card p-4 my-3">
    <h2>{{#str}}manageactivity, mcp{{/str}}</h2>
    {{> mod_mcp/prompt_selector}}
    <a class="btn btn-outline-secondary mb-3" href="{{{previewurl}}}">{{#str}}preview, mcp{{/str}}</a>
    {{#canpublish}}
        <form action="{{actionurl}}" method="post">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="id" value="{{cmid}}">
            <input type="hidden" name="revision" value="{{revision}}">
            <input type="hidden" name="action" value="publish">
            <button class="btn btn-primary" type="submit">{{#str}}publish, mcp{{/str}}</button>
        </form>
    {{/canpublish}}
</section>
